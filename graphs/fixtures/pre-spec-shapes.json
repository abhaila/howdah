{
  "implement-slice": {
    "name": "implement-slice",
    "description": "Design a vertical slice on the code map, get it approved, build it and verify it against the design",
    "defaults": {
      "permissionMode": "auto"
    },
    "entry": "create_worktree",
    "inputs": [
      "goal",
      "work"
    ],
    "nodes": {
      "cleanup_closed": {
        "kind": "worktree",
        "action": "remove",
        "writes": {
          "worktree.clean": {
            "scope": "per-visit"
          }
        }
      },
      "cleanup_merged": {
        "kind": "worktree",
        "action": "remove",
        "writes": {
          "worktree.clean": {
            "scope": "per-visit"
          }
        }
      },
      "cleanup_pending": {
        "kind": "terminal",
        "outcome": "failed",
        "label": "Worktree retained to preserve local work",
        "writes": {}
      },
      "closed": {
        "kind": "terminal",
        "outcome": "aborted",
        "writes": {}
      },
      "complete": {
        "kind": "terminal",
        "outcome": "success",
        "writes": {}
      },
      "complete_ticket": {
        "kind": "agent",
        "prompt": "complete_ticket",
        "reads": [
          "goal",
          "work",
          "publication_summary"
        ],
        "writes": {
          "completion_summary": {
            "scope": "sticky"
          }
        }
      },
      "create_worktree": {
        "kind": "worktree",
        "action": "create",
        "writes": {
          "worktree.verify_command": {
            "scope": "sticky"
          }
        }
      },
      "delivery.address_reviews": {
        "kind": "agent",
        "prompt": "slice.address_reviews",
        "reads": [
          "goal",
          "work",
          "publication_summary",
          "review_verdict",
          "review_findings",
          "slice.ghosts",
          "slice.drift"
        ],
        "writes": {
          "repair_summary": {
            "scope": "sticky"
          }
        },
        "class": "delivery"
      },
      "delivery.drift": {
        "kind": "command",
        "run": "map:drift --since delivery.publish",
        "reads": [
          "slice.ghosts",
          "map.base",
          "map.after"
        ],
        "writes": {
          "slice.drift": {
            "scope": "per-visit"
          }
        },
        "class": "delivery"
      },
      "delivery.drift_revision": {
        "kind": "command",
        "run": "map:drift --since delivery.publish",
        "reads": [
          "slice.ghosts",
          "map.base",
          "map.after"
        ],
        "writes": {
          "slice.drift": {
            "scope": "per-visit"
          }
        },
        "class": "delivery"
      },
      "delivery.fix_ci": {
        "kind": "agent",
        "prompt": "slice.fix_ci",
        "reads": [
          "goal",
          "work",
          "publication_summary",
          "review_verdict",
          "review_findings",
          "slice.ghosts",
          "slice.drift"
        ],
        "writes": {
          "repair_summary": {
            "scope": "sticky"
          }
        },
        "class": "delivery"
      },
      "delivery.probe_pr": {
        "kind": "command",
        "run": "probe:pr",
        "reads": [
          "publication_summary"
        ],
        "writes": {
          "pr.state": {
            "scope": "per-visit"
          }
        },
        "class": "delivery"
      },
      "delivery.publish": {
        "kind": "agent",
        "prompt": "delivery.publish",
        "reads": [
          "goal",
          "work"
        ],
        "writes": {
          "publication_summary": {
            "scope": "sticky"
          }
        },
        "class": "delivery",
        "maxVisits": 5
      },
      "delivery.reextract": {
        "kind": "command",
        "run": "map:reextract",
        "reads": [
          "map.base"
        ],
        "writes": {
          "map.after": {
            "scope": "per-visit"
          }
        },
        "class": "delivery"
      },
      "delivery.reextract_revision": {
        "kind": "command",
        "run": "map:reextract",
        "reads": [
          "map.base"
        ],
        "writes": {
          "map.after": {
            "scope": "per-visit"
          }
        },
        "class": "delivery"
      },
      "delivery.resolve_conflicts": {
        "kind": "agent",
        "prompt": "slice.resolve_conflicts",
        "reads": [
          "goal",
          "work",
          "publication_summary",
          "slice.ghosts",
          "slice.drift"
        ],
        "writes": {
          "repair_summary": {
            "scope": "sticky"
          }
        },
        "class": "delivery"
      },
      "delivery.review_repairs": {
        "kind": "agent",
        "prompt": "slice.review_repairs",
        "reads": [
          "goal",
          "work",
          "publication_summary",
          "repair_summary",
          "slice.ghosts",
          "slice.drift"
        ],
        "writes": {
          "review_findings": {
            "scope": "cleared"
          },
          "review_verdict": {
            "scope": "cleared"
          }
        },
        "class": "delivery"
      },
      "delivery.revise_repairs": {
        "kind": "agent",
        "prompt": "slice.revise_repairs",
        "reads": [
          "goal",
          "work",
          "publication_summary",
          "repair_summary",
          "review_verdict",
          "review_findings",
          "slice.ghosts",
          "slice.drift"
        ],
        "writes": {
          "repair_summary": {
            "scope": "sticky"
          }
        },
        "class": "delivery",
        "maxVisits": 3
      },
      "delivery.wait": {
        "kind": "wait",
        "duration": "5m",
        "class": "delivery",
        "writes": {}
      },
      "implementation.implement": {
        "kind": "agent",
        "prompt": "slice.implement",
        "requires": {
          "approvalOf": "slice.approve"
        },
        "reads": [
          "goal",
          "work",
          "slice.ghosts",
          "slice.approval",
          "slice.drift",
          "review_findings",
          "worktree.verify_command"
        ],
        "writes": {
          "implementation_summary": {
            "scope": "sticky"
          }
        },
        "maxVisits": 3,
        "class": "implementation"
      },
      "implementation.local_review": {
        "kind": "agent",
        "prompt": "slice.local_review",
        "reads": [
          "goal",
          "work",
          "slice.ghosts",
          "implementation_summary",
          "slice.drift",
          "verify.result"
        ],
        "writes": {
          "review_findings": {
            "scope": "cleared"
          },
          "review_verdict": {
            "scope": "cleared"
          }
        },
        "class": "implementation"
      },
      "map.drift": {
        "kind": "command",
        "run": "map:drift",
        "reads": [
          "slice.ghosts",
          "map.base",
          "map.after"
        ],
        "writes": {
          "slice.drift": {
            "scope": "per-visit"
          }
        },
        "class": "map"
      },
      "map.extract": {
        "kind": "command",
        "run": "map:extract",
        "reads": [
          "goal",
          "work"
        ],
        "writes": {
          "map.base": {
            "scope": "sticky"
          },
          "map.neighbourhood": {
            "scope": "sticky"
          },
          "review_findings": {
            "scope": "cleared"
          },
          "slice.drift": {
            "scope": "per-visit"
          }
        },
        "maxVisits": 5,
        "class": "map"
      },
      "map.reextract": {
        "kind": "command",
        "run": "map:reextract",
        "reads": [
          "map.base"
        ],
        "writes": {
          "map.after": {
            "scope": "per-visit"
          }
        },
        "class": "map"
      },
      "slice.approve": {
        "kind": "approval",
        "proposal": "slice.ghosts",
        "base": "map.base",
        "decision": "slice.approval",
        "feedback": "slice.feedback",
        "redesignTo": "map.extract",
        "class": "slice",
        "writes": {}
      },
      "slice.propose": {
        "kind": "agent",
        "prompt": "slice.propose",
        "readOnly": true,
        "reads": [
          "goal",
          "work",
          "map.base",
          "map.neighbourhood",
          "slice.feedback"
        ],
        "writes": {
          "slice.ghosts": {
            "scope": "per-visit"
          }
        },
        "class": "slice"
      },
      "verify.run": {
        "kind": "command",
        "run": "verify:run",
        "writes": {
          "verify.result": {
            "scope": "per-visit"
          }
        },
        "class": "implementation"
      }
    },
    "edges": [
      {
        "from": "create_worktree",
        "to": "map.extract"
      },
      {
        "from": "map.extract",
        "to": "slice.propose"
      },
      {
        "from": "slice.propose",
        "to": "slice.approve"
      },
      {
        "from": "slice.approve",
        "to": "implementation.implement",
        "label": "slice.approval == 'approved'",
        "reads": [
          "slice.approval"
        ],
        "rank": 0,
        "beatsFallback": true
      },
      {
        "from": "slice.approve",
        "to": "slice.propose",
        "label": "slice.approval == 'feedback'",
        "reads": [
          "slice.approval"
        ],
        "rank": 1,
        "beatsFallback": true
      },
      {
        "from": "slice.approve",
        "to": "map.extract",
        "label": "slice.approval == 'stale'",
        "reads": [
          "slice.approval"
        ],
        "rank": 2,
        "beatsFallback": true
      },
      {
        "from": "implementation.implement",
        "to": "map.reextract"
      },
      {
        "from": "map.reextract",
        "to": "map.drift"
      },
      {
        "from": "map.drift",
        "to": "verify.run"
      },
      {
        "from": "verify.run",
        "to": "implementation.local_review"
      },
      {
        "from": "implementation.local_review",
        "to": "implementation.implement",
        "label": "review_verdict == 'reject'",
        "reads": [
          "review_verdict"
        ],
        "rank": 0,
        "beatsFallback": true
      },
      {
        "from": "implementation.local_review",
        "to": "delivery.publish",
        "label": "review_verdict == 'pass'",
        "reads": [
          "review_verdict"
        ],
        "rank": 1,
        "beatsFallback": true
      },
      {
        "from": "delivery.publish",
        "to": "delivery.probe_pr"
      },
      {
        "from": "delivery.probe_pr",
        "to": "complete_ticket",
        "label": "pr.state == 'MERGED'",
        "reads": [
          "pr.state"
        ],
        "rank": 0,
        "beatsFallback": true
      },
      {
        "from": "delivery.probe_pr",
        "to": "cleanup_closed",
        "label": "pr.state == 'CLOSED'",
        "reads": [
          "pr.state"
        ],
        "rank": 1,
        "beatsFallback": true
      },
      {
        "from": "delivery.probe_pr",
        "to": "delivery.resolve_conflicts",
        "label": "pr.state == 'CONFLICTS'",
        "reads": [
          "pr.state"
        ],
        "rank": 2,
        "beatsFallback": true
      },
      {
        "from": "delivery.probe_pr",
        "to": "delivery.address_reviews",
        "label": "pr.state == 'CHANGES_REQUIRED'",
        "reads": [
          "pr.state"
        ],
        "rank": 3,
        "beatsFallback": true
      },
      {
        "from": "delivery.probe_pr",
        "to": "delivery.fix_ci",
        "label": "pr.state == 'CI_FAILED'",
        "reads": [
          "pr.state"
        ],
        "rank": 4,
        "beatsFallback": true
      },
      {
        "from": "delivery.probe_pr",
        "to": "delivery.wait"
      },
      {
        "from": "delivery.review_repairs",
        "to": "delivery.revise_repairs",
        "label": "review_verdict == 'reject'",
        "reads": [
          "review_verdict"
        ],
        "rank": 0,
        "beatsFallback": true
      },
      {
        "from": "delivery.review_repairs",
        "to": "delivery.publish",
        "label": "review_verdict == 'pass'",
        "reads": [
          "review_verdict"
        ],
        "rank": 1,
        "beatsFallback": true
      },
      {
        "from": "delivery.wait",
        "to": "delivery.probe_pr"
      },
      {
        "from": "complete_ticket",
        "to": "cleanup_merged"
      },
      {
        "from": "cleanup_merged",
        "to": "complete",
        "label": "worktree.clean == true",
        "reads": [
          "worktree.clean"
        ],
        "rank": 0,
        "beatsFallback": true
      },
      {
        "from": "cleanup_merged",
        "to": "cleanup_pending"
      },
      {
        "from": "cleanup_closed",
        "to": "closed",
        "label": "worktree.clean == true",
        "reads": [
          "worktree.clean"
        ],
        "rank": 0,
        "beatsFallback": true
      },
      {
        "from": "cleanup_closed",
        "to": "cleanup_pending"
      },
      {
        "from": "delivery.resolve_conflicts",
        "to": "delivery.reextract"
      },
      {
        "from": "delivery.fix_ci",
        "to": "delivery.reextract"
      },
      {
        "from": "delivery.address_reviews",
        "to": "delivery.reextract"
      },
      {
        "from": "delivery.reextract",
        "to": "delivery.drift"
      },
      {
        "from": "delivery.drift",
        "to": "delivery.revise_repairs",
        "label": "slice.drift has new problems (missing / changed-unexpectedly / still-present / unchanged)",
        "reads": [
          "slice.drift"
        ],
        "rank": 0,
        "beatsFallback": true
      },
      {
        "from": "delivery.drift",
        "to": "delivery.review_repairs"
      },
      {
        "from": "delivery.revise_repairs",
        "to": "delivery.reextract_revision"
      },
      {
        "from": "delivery.reextract_revision",
        "to": "delivery.drift_revision"
      },
      {
        "from": "delivery.drift_revision",
        "to": "delivery.revise_repairs",
        "label": "slice.drift has new problems (missing / changed-unexpectedly / still-present / unchanged)",
        "reads": [
          "slice.drift"
        ],
        "rank": 0,
        "beatsFallback": true
      },
      {
        "from": "delivery.drift_revision",
        "to": "delivery.publish"
      }
    ]
  },
