        "from": "review.seq_review",
        "to": "report.compile"
      },
      {
        "from": "report.compile",
        "to": "complete"
      }
    ]
  },
  "write-doc": {
    "name": "write-doc",
    "description": "Outline, draft, and review a document in a plain folder — no repo required",
    "defaults": {
      "permissionMode": "auto"
    },
    "entry": "doc.outline",
    "inputs": [
      "goal",
      "work"
    ],
    "nodes": {
      "doc.draft": {
        "kind": "agent",
        "prompt": "doc.draft",
        "reads": [
          "goal",
          "work",
          "doc_outline"
        ],
        "writes": {
          "doc_summary": {
            "scope": "sticky"
          }
        }
      },
      "doc.outline": {
        "kind": "agent",
        "prompt": "doc.outline",
        "reads": [
          "goal",
          "work"
        ],
        "writes": {
          "doc_outline": {
            "scope": "sticky"
          }
        }
      },
      "doc.review": {
        "kind": "agent",
        "prompt": "doc.review",
        "reads": [
          "goal",
          "work",
          "doc_outline",
          "doc_summary"
        ],
        "writes": {
          "review_findings": {
            "scope": "cleared"
          },
          "review_verdict": {
            "scope": "cleared"
          }
        }
      },
      "doc.revise": {
        "kind": "agent",
        "prompt": "doc.revise",
        "reads": [
          "goal",
          "work",
          "doc_outline",
          "doc_summary",
          "review_findings"
        ],
        "writes": {
          "doc_summary": {
            "scope": "sticky"
          }
        },
        "maxVisits": 3
      },
      "done": {
        "kind": "terminal",
        "outcome": "success",
        "label": "document approved",
        "writes": {}
      }
    },
    "edges": [
      {
        "from": "doc.outline",
        "to": "doc.draft"
      },
      {
        "from": "doc.draft",
        "to": "doc.review"
      },
      {
        "from": "doc.review",
        "to": "doc.revise",
        "label": "review_verdict == 'reject'",
        "reads": [
          "review_verdict"
        ],
        "rank": 0,
        "beatsFallback": true
      },
      {
        "from": "doc.review",
        "to": "done",
        "label": "review_verdict == 'pass'",
        "reads": [
          "review_verdict"
        ],
        "rank": 1,
        "beatsFallback": true
      },
      {
        "from": "doc.revise",
        "to": "doc.review"
      }
    ]
  }
}
