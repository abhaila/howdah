  "plan-feature": {
    "name": "plan-feature",
    "description": "Plan a large feature into vertical slices, raise a ticket each, and launch a run per slice",
    "defaults": {
      "permissionMode": "auto"
    },
    "entry": "create_worktree",
    "inputs": [
      "goal",
      "work"
    ],
    "nodes": {
      "cleanup": {
        "kind": "worktree",
        "action": "remove",
        "writes": {
          "worktree.clean": {
            "scope": "per-visit"
          }
        },
        "class": "cleanup"
      },
      "cleanup_pending": {
        "kind": "terminal",
        "outcome": "failed",
        "label": "Worktree retained to preserve local work",
        "writes": {}
      },
      "create_worktree": {
        "kind": "worktree",
        "action": "create",
        "writes": {}
      },
      "launched": {
        "kind": "terminal",
        "outcome": "success",
        "writes": {}
      },
      "map.extract": {
        "kind": "command",
        "run": "map:extract",
        "reads": [
          "goal",
          "work"
        ],
        "writes": {
          "map.base": {
            "scope": "sticky"
          },
          "map.neighbourhood": {
            "scope": "sticky"
          }
        },
        "maxVisits": 5,
        "class": "map"
      },
      "plan.approve": {
        "kind": "approval",
        "proposal": "plan.slices",
        "base": "map.base",
        "decision": "plan.approval",
        "feedback": "plan.feedback",
        "redesignTo": "map.extract",
        "class": "plan",
        "writes": {}
      },
      "plan.propose": {
        "kind": "agent",
        "prompt": "plan.propose",
        "readOnly": true,
        "reads": [
          "goal",
          "work",
          "map.base",
          "map.neighbourhood",
          "plan.feedback"
        ],
        "writes": {
          "plan.slices": {
            "scope": "per-visit"
          }
        },
        "class": "plan"
      },
      "runs.launch": {
        "kind": "command",
        "run": "runs:launch",
        "reads": [
          "plan.slices",
          "tickets"
        ],
        "writes": {
          "launched": {
            "scope": "sticky"
          }
        },
        "maxVisits": 3,
        "class": "tickets"
      },
      "tickets.create": {
        "kind": "agent",
        "prompt": "plan.tickets",
        "requires": {
          "approvalOf": "plan.approve"
        },
        "reads": [
          "goal",
          "work",
          "plan.slices",
          "plan.approval"
        ],
        "writes": {
          "tickets": {
            "scope": "sticky"
          }
        },
        "maxVisits": 2,
        "class": "tickets"
      }
    },
    "edges": [
      {
        "from": "create_worktree",
        "to": "map.extract"
      },
      {
        "from": "map.extract",
        "to": "plan.propose"
      },
      {
        "from": "plan.propose",
        "to": "plan.approve"
      },
      {
        "from": "plan.approve",
        "to": "tickets.create",
        "label": "plan.approval == 'approved'",
        "reads": [
          "plan.approval"
        ],
        "rank": 0,
        "beatsFallback": true
      },
      {
        "from": "plan.approve",
        "to": "plan.propose",
        "label": "plan.approval == 'feedback'",
        "reads": [
          "plan.approval"
        ],
        "rank": 1,
        "beatsFallback": true
      },
      {
        "from": "plan.approve",
        "to": "map.extract",
        "label": "plan.approval == 'stale'",
        "reads": [
          "plan.approval"
        ],
        "rank": 2,
        "beatsFallback": true
      },
      {
        "from": "tickets.create",
        "to": "runs.launch"
      },
      {
        "from": "runs.launch",
        "to": "cleanup"
      },
      {
        "from": "cleanup",
        "to": "launched",
        "label": "worktree.clean",
        "reads": [
          "worktree.clean"
        ],
        "rank": 0,
        "beatsFallback": true
      },
      {
        "from": "cleanup",
        "to": "cleanup_pending"
      }
    ]
  },
