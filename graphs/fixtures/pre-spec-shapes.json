      {
        "from": "implementation.local_review",
        "to": "delivery.publish",
        "label": "review_verdict == 'pass'",
        "reads": [
          "review_verdict"
        ],
        "rank": 1,
        "beatsFallback": true
      },
      {
        "from": "implementation.plan_review",
        "to": "implementation.implement_review"
      },
      {
        "from": "implementation.implement_review",
        "to": "verify.run"
      },
      {
        "from": "delivery.publish",
        "to": "delivery.probe_pr"
      },
      {
        "from": "delivery.probe_pr",
        "to": "complete_ticket",
        "label": "pr.state == 'MERGED'",
